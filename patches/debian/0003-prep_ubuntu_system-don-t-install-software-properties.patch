From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tetsuya Hayashi <tetsu.h@gmail.com>
Date: Thu, 26 Nov 2026 00:51:52 +0900
Subject: [PATCH] prep_ubuntu_system: handle Debian 13 packages

Drop the unavailable software-properties-common on Debian 13+. Keep IPv4 and bounded retries for LLVM wget requests after the upstream switch from llvm.sh to apt-get.

Upstream-Status: Pending
Distro-Scope: debian-12, debian-13
---
 install_dependencies.sh | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/install_dependencies.sh b/install_dependencies.sh
index 98d4f19..751365a 100755
--- a/install_dependencies.sh
+++ b/install_dependencies.sh
@@ -272,18 +272,24 @@ prep_ubuntu_system() {
     echo "[INFO] Preparing Ubuntu/Debian system..."
     # Update package lists and install basic tools
     apt-get update
-    apt-get install -y --no-install-recommends ca-certificates gpg lsb-release wget software-properties-common gnupg jq
+    # Debian 13+ no longer packages software-properties-common.
+    local base_pkgs=(ca-certificates gpg lsb-release wget gnupg jq)
+    case "$OS_CODENAME" in
+        trixie|forky|unstable) ;;
+        *) base_pkgs+=(software-properties-common) ;;
+    esac
+    apt-get install -y --no-install-recommends "${base_pkgs[@]}"
 
     # Add LLVM repositories
     local llvm_keyring="/usr/share/keyrings/llvm-snapshot.gpg"
     local llvm_keyring_tmp
     llvm_keyring_tmp="$(mktemp "${llvm_keyring}.XXXXXX")"
-    ( set -o pipefail; wget -O - https://apt.llvm.org/llvm-snapshot.gpg.key | gpg --dearmor --batch --yes --no-tty -o "$llvm_keyring_tmp" )
+    ( set -o pipefail; wget -4 --timeout=15 --tries=3 --retry-connrefused -O - https://apt.llvm.org/llvm-snapshot.gpg.key | gpg --dearmor --batch --yes --no-tty -o "$llvm_keyring_tmp" )
     chmod 0644 "$llvm_keyring_tmp"
     mv -f "$llvm_keyring_tmp" "$llvm_keyring"
     # apt.llvm.org doesn't publish v20 for newer releases (e.g. Ubuntu 26.04, whose
     # own archive ships clang-20), and a missing repo makes apt-get update fail.
-    if wget -q --spider "https://apt.llvm.org/$OS_CODENAME/dists/llvm-toolchain-$OS_CODENAME-20/Release"; then
+    if wget -4 -q --timeout=15 --tries=3 --retry-connrefused --spider "https://apt.llvm.org/$OS_CODENAME/dists/llvm-toolchain-$OS_CODENAME-20/Release"; then
         echo "deb [signed-by=$llvm_keyring] https://apt.llvm.org/$OS_CODENAME/ llvm-toolchain-$OS_CODENAME-20 main" | tee /etc/apt/sources.list.d/llvm-20.list
     else
         echo "[INFO] apt.llvm.org has no LLVM 20 repository for $OS_CODENAME; using the distro archive"
