From c0310852422d10ed943d6f2a4ff13231656ac898 Mon Sep 17 00:00:00 2001
From: Tetsuya Hayashi <tetsu.h@gmail.com>
Date: Fri, 28 Aug 2026 22:53:13 +0900
Subject: [PATCH] prep_ubuntu_system: preseed LLVM key on noble derivatives

Linux Mint 22.x uses Ubuntu noble repositories. Its prep phase already downloads the LLVM signing key, but llvm.sh later fetches the same key again. Preseed the valid armored key at the path llvm.sh checks and retain a validated dearmored keyring for apt, using one bounded IPv4 download and atomic replacement so a transient network or validation failure cannot damage existing trust material.

Distro-Scope: linuxmint-22.1, linuxmint-22.2, linuxmint-22.3
Upstream-Status: Pending
---
 install_dependencies.sh | 78 +++++++++++++++++++++++++++++++++++++----
 1 file changed, 72 insertions(+), 6 deletions(-)

diff --git a/install_dependencies.sh b/install_dependencies.sh
index 6dc561e..267bfe5 100755
--- a/install_dependencies.sh
+++ b/install_dependencies.sh
@@ -274,13 +274,79 @@ prep_ubuntu_system() {
     apt-get update
     apt-get install -y --no-install-recommends ca-certificates gpg lsb-release wget software-properties-common gnupg jq
 
-    # Add LLVM repository for Clang 17
+    # Add LLVM repository for Clang 17.  Linux Mint 22.x is based on Ubuntu
+    # noble; preseed the key in the format llvm.sh expects so its later
+    # download_key() call does not repeat an unreliable network request.
     local llvm_keyring="/usr/share/keyrings/llvm-snapshot.gpg"
-    local llvm_keyring_tmp
-    llvm_keyring_tmp="$(mktemp "${llvm_keyring}.XXXXXX")"
-    ( set -o pipefail; wget -O - https://apt.llvm.org/llvm-snapshot.gpg.key | gpg --dearmor --batch --yes --no-tty -o "$llvm_keyring_tmp" )
-    chmod 0644 "$llvm_keyring_tmp"
-    mv -f "$llvm_keyring_tmp" "$llvm_keyring"
+    local llvm_trusted_key="/etc/apt/trusted.gpg.d/apt.llvm.org.asc"
+    if [ "$UBUNTU_CODENAME" = "noble" ]; then
+        (
+            set -e
+            local llvm_expected_fingerprint="6084F3CF814B57C1CF12EFD515CF4D18AF4F7421"
+            local llvm_key_ascii_tmp="" llvm_keyring_tmp="" llvm_trusted_key_tmp=""
+            cleanup_llvm_key_temps() {
+                [ -z "$llvm_key_ascii_tmp" ] || rm -f -- "$llvm_key_ascii_tmp"
+                [ -z "$llvm_keyring_tmp" ] || rm -f -- "$llvm_keyring_tmp"
+                [ -z "$llvm_trusted_key_tmp" ] || rm -f -- "$llvm_trusted_key_tmp"
+            }
+            trap cleanup_llvm_key_temps EXIT
+            llvm_key_fingerprint() {
+                local key_file="$1" fingerprint
+                if ! fingerprint="$(
+                    set -o pipefail
+                    gpg --batch --quiet --show-keys --with-colons "$key_file" 2>/dev/null |
+                        awk -F: '$1 == "pub" { want_fpr=1; next } want_fpr && $1 == "fpr" { print $10; want_fpr=0 }'
+                )"; then
+                    return 1
+                fi
+                printf '%s\n' "$fingerprint"
+            }
+            llvm_armored_key_matches() {
+                local key_file="$1"
+                [ -s "$key_file" ] || return 1
+                grep -q '^-----BEGIN PGP PUBLIC KEY BLOCK-----$' "$key_file" || return 1
+                [ "$(llvm_key_fingerprint "$key_file")" = "$llvm_expected_fingerprint" ]
+            }
+            llvm_keyring_matches() {
+                local key_file="$1"
+                [ -s "$key_file" ] || return 1
+                [ "$(llvm_key_fingerprint "$key_file")" = "$llvm_expected_fingerprint" ]
+            }
+
+            if llvm_armored_key_matches "$llvm_trusted_key" \
+                && llvm_keyring_matches "$llvm_keyring"; then
+                echo "[INFO] Valid LLVM apt key already exists; skipping key fetch (noble preseed)."
+            else
+                llvm_key_ascii_tmp="$(mktemp "${TMPDIR:-/tmp}/apt.llvm.org.asc.XXXXXX")"
+                llvm_keyring_tmp="$(mktemp "${llvm_keyring}.XXXXXX")"
+                llvm_trusted_key_tmp="$(mktemp "${llvm_trusted_key}.XXXXXX")"
+                wget -4 --connect-timeout=10 --read-timeout=15 --tries=3 --waitretry=1 --retry-connrefused \
+                    -O "$llvm_key_ascii_tmp" https://apt.llvm.org/llvm-snapshot.gpg.key
+                grep -q '^-----BEGIN PGP PUBLIC KEY BLOCK-----$' "$llvm_key_ascii_tmp"
+                gpg --batch --yes --no-tty --dearmor -o "$llvm_keyring_tmp" "$llvm_key_ascii_tmp"
+                if ! llvm_armored_key_matches "$llvm_key_ascii_tmp" \
+                    || ! llvm_keyring_matches "$llvm_keyring_tmp"; then
+                    echo "[ERROR] Downloaded LLVM apt key has an unexpected fingerprint." >&2
+                    exit 1
+                fi
+                chmod 0644 "$llvm_keyring_tmp"
+                cp -- "$llvm_key_ascii_tmp" "$llvm_trusted_key_tmp"
+                chmod 0644 "$llvm_trusted_key_tmp"
+                mv -f "$llvm_keyring_tmp" "$llvm_keyring"
+                llvm_keyring_tmp=""
+                # Publish the llvm.sh sentinel last, after the signed-by keyring.
+                mv -f "$llvm_trusted_key_tmp" "$llvm_trusted_key"
+                llvm_trusted_key_tmp=""
+                echo "[INFO] LLVM apt key preseeded for noble (IPv4-bounded fetch)."
+            fi
+        )
+    else
+        local llvm_keyring_tmp
+        llvm_keyring_tmp="$(mktemp "${llvm_keyring}.XXXXXX")"
+        ( set -o pipefail; wget -O - https://apt.llvm.org/llvm-snapshot.gpg.key | gpg --dearmor --batch --yes --no-tty -o "$llvm_keyring_tmp" )
+        chmod 0644 "$llvm_keyring_tmp"
+        mv -f "$llvm_keyring_tmp" "$llvm_keyring"
+    fi
     echo "deb [signed-by=$llvm_keyring] https://apt.llvm.org/$OS_CODENAME/ llvm-toolchain-$OS_CODENAME-17 main" | tee /etc/apt/sources.list.d/llvm-17.list
     # Also v20
     echo "deb [signed-by=$llvm_keyring] https://apt.llvm.org/$OS_CODENAME/ llvm-toolchain-$OS_CODENAME-20 main" | tee /etc/apt/sources.list.d/llvm-20.list
